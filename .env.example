# Supabase 프로젝트 연결 정보
# Supabase 대시보드 > Project Settings > API 에서 확인 가능합니다.
# 이 파일은 예시용 템플릿입니다. 실제 값은 절대 커밋하지 말고 .env.local에만 넣으세요.

# 프로젝트 URL (예: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon / publishable key (클라이언트에 노출되어도 되는 공개 키, RLS로 보호됨)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# service_role key (서버 전용, RLS 우회 가능한 비밀 키)
# - NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요 (붙이면 브라우저에 노출됩니다).
# - 서버 사이드 관리자 기능을 추가할 때만 사용하고, .env.local에만 보관하세요.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
